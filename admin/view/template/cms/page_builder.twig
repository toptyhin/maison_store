{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="btn-preview" class="btn btn-info"><i class="fa fa-eye"></i> {{ text_preview }}</button>
        <a href="{{ storefront_url }}" target="_blank" class="btn btn-default"><i class="fa fa-external-link"></i> {{ text_open_site }}</a>
        <button type="submit" form="form-page-meta" class="btn btn-success"><i class="fa fa-check"></i> {{ text_publish }}</button>
        <button type="button" id="btn-delete-page" class="btn btn-danger"><i class="fa fa-trash-o"></i> {{ button_delete_page }}</button>
        <a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ page.name }} — {{ text_builder }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}

    <form action="{{ action }}" method="post" id="form-page-meta" class="form-horizontal" style="margin-bottom:15px">
      <input type="hidden" name="save_page" value="1" />
      <div class="panel panel-default">
        <div class="panel-body">
          <div class="col-sm-3"><input type="text" name="name" value="{{ page.name }}" class="form-control" placeholder="{{ entry_name }}" /></div>
          <div class="col-sm-2"><input type="hidden" name="route" value="{{ page.route }}" /><input type="hidden" name="entity_id" value="{{ page.entity_id }}" /><input type="hidden" name="store_id" value="{{ page.store_id }}" /></div>
          <div class="col-sm-2">
            <select name="status" class="form-control">
              <option value="1" {% if page.status %}selected{% endif %}>{{ text_enabled }}</option>
              <option value="0" {% if not page.status %}selected{% endif %}>{{ text_disabled }}</option>
            </select>
          </div>
        </div>
      </div>
    </form>

    <div class="row">
      <div class="col-md-7">
        <div class="panel panel-default">
          <div class="panel-heading clearfix">
            <span class="pull-left"><i class="fa fa-th-large"></i> Блоки страницы</span>
            <button type="button" class="btn btn-primary btn-sm pull-right" data-toggle="modal" data-target="#modal-add-block"><i class="fa fa-plus"></i> {{ text_add_block }}</button>
          </div>
          <div class="panel-body">
            <div id="cms-blocks-list">
              {% if blocks %}
              {% for item in blocks %}
              {% include 'cms/block_item.twig' with { block: item.block, label: item.label, slots: slots, languages: languages, categories: categories, modules: modules, placeholder: placeholder, text_save_block: text_save_block, text_delete_block: text_delete_block, entry_slot: entry_slot, entry_block_status: entry_block_status } %}
              {% endfor %}
              {% else %}
              <p class="text-center text-muted">{{ text_no_blocks }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-5">
        <div class="panel panel-default">
          <div class="panel-heading"><i class="fa fa-eye"></i> {{ text_preview }}</div>
          <div class="panel-body" style="padding:0">
            <iframe id="cms-preview-frame" src="about:blank" style="width:100%;height:70vh;border:0;background:#f5f7fa"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
#modal-add-block .btn-add-block-type {
  height: auto;
  line-height: 1.4;
  padding: 12px 14px;
  white-space: normal;
  text-align: left;
}
#modal-add-block .btn-add-block-type .cms-block-type-btn__title {
  display: block;
  font-weight: 600;
}
#modal-add-block .btn-add-block-type .cms-block-type-btn__title .fa {
  margin-right: 4px;
}
#modal-add-block .btn-add-block-type .cms-block-type-btn__desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  font-weight: normal;
  color: #777;
}
</style>

<div class="modal fade" id="modal-add-block" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title">{{ text_select_block }}</h4></div>
      <div class="modal-body">
        <div class="row">
          {% for t in allowed_types %}
          <div class="col-sm-6" style="margin-bottom:10px">
            <button type="button" class="btn btn-default btn-block btn-add-block-type" data-type="{{ t.type }}" data-slot="main">
              <span class="cms-block-type-btn__title"><i class="fa fa-{{ t.icon == 'image' ? 'picture-o' : 'cube' }}"></i> {{ t.label }}</span>
              <small class="cms-block-type-btn__desc">{{ t.description }}</small>
            </button>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/html" id="cms-feature-item-template">
<div class="well well-sm feature-item-row">
  <div class="form-group"><label class="col-sm-3">Иконка</label><div class="col-sm-9"><input type="text" name="settings[items][__INDEX__][icon]" value="star" class="form-control" placeholder="shopping_bag" /></div></div>
  <input type="hidden" name="settings[items][__INDEX__][status]" value="1" />
  {% for language in languages %}
  <div class="form-group"><label class="col-sm-3">{{ language.name }} title</label><div class="col-sm-9"><input type="text" name="settings[items][__INDEX__][title][{{ language.language_id }}]" value="" class="form-control" /></div></div>
  <div class="form-group"><label class="col-sm-3">{{ language.name }} subtitle</label><div class="col-sm-9"><input type="text" name="settings[items][__INDEX__][subtitle][{{ language.language_id }}]" value="" class="form-control" /></div></div>
  {% endfor %}
</div>
</script>

<script>
(function(){
  var pageId = {{ page_id }};
  var userToken = '{{ user_token }}';
  var previewTokenUrl = 'index.php?route=cms/page/previewToken&user_token=' + userToken + '&page_id=' + pageId;
  var deletePageUrl = 'index.php?route=cms/page/delete&user_token=' + userToken + '&page_id=' + pageId;

  $('#btn-delete-page').on('click', function() {
    if (confirm('{{ text_confirm_delete_page|e('js') }}')) {
      window.location.href = deletePageUrl;
    }
  });

  function refreshPreview() {
    $.getJSON(previewTokenUrl, function(json) {
      if (json.url) {
        $('#cms-preview-frame').attr('src', json.url + '&t=' + Date.now());
      }
    });
  }

  $('#btn-preview').on('click', refreshPreview);
  refreshPreview();

  $(document).on('change', '.cms-link-type', function() {
    var $wrap = $(this).closest('.cms-link-picker');
    var type = $(this).val();
    $wrap.find('.cms-link-category, .cms-link-information, .cms-link-custom').hide();
    if (type === 'category') $wrap.find('.cms-link-category').show();
    if (type === 'information') $wrap.find('.cms-link-information').show();
    if (type === 'custom') $wrap.find('.cms-link-custom').show();
  });

  function appendBlock(blockId) {
    $.getJSON('index.php?route=cms/page/renderBlock&user_token=' + userToken + '&block_id=' + blockId, function(res) {
      if (res.success && res.html) {
        $('#cms-blocks-list > p.text-muted').remove();
        $('#cms-blocks-list').append(res.html);
        refreshPreview();
        var $block = $('#block-' + blockId);
        if ($block.length) {
          $('html, body').animate({ scrollTop: $block.offset().top - 80 }, 300);
        }
      } else if (res.error) {
        alert(res.error);
      }
    });
  }

  $('.btn-add-block-type').on('click', function() {
    var type = $(this).data('type');
    var slot = $(this).data('slot');
    var $btn = $(this);
    $btn.prop('disabled', true);
    $.post('index.php?route=cms/page/addBlock&user_token=' + userToken, { page_id: pageId, type: type, slot: slot }, function(json) {
      $btn.prop('disabled', false);
      if (json.success && json.block_id) {
        $('#modal-add-block').modal('hide');
        appendBlock(json.block_id);
      } else if (json.error) {
        alert(json.error);
      }
    }, 'json').fail(function() {
      $btn.prop('disabled', false);
    });
  });

  $(document).on('click', '.btn-save-block', function() {
    var $form = $(this).closest('.cms-block-form');
    var blockId = $form.data('block-id');
    $.post('index.php?route=cms/page/saveBlock&user_token=' + userToken, $form.serialize(), function(json) {
      if (json.success) { refreshPreview(); alert('Блок сохранён'); }
      else if (json.error) alert(json.error);
    }, 'json');
  });

  $(document).on('click', '.btn-delete-block', function() {
    if (!confirm('Удалить блок?')) return;
    var blockId = $(this).closest('.cms-block-form').data('block-id');
    $.post('index.php?route=cms/page/deleteBlock&user_token=' + userToken, { block_id: blockId }, function(json) {
      if (json.success) { $('#block-' + blockId).remove(); refreshPreview(); }
    }, 'json');
  });

  var featureItemTemplate = $('#cms-feature-item-template').html();

  $(document).on('click', '.add-feature-item', function() {
    var blockId = $(this).data('block');
    var $container = $('#feature-items-' + blockId);
    var index = $container.find('.feature-item-row').length;
    $container.append(featureItemTemplate.replace(/__INDEX__/g, index));
  });

  var el = document.getElementById('cms-blocks-list');
  if (el && typeof Sortable !== 'undefined') {
    Sortable.create(el, {
      handle: '.panel-heading',
      animation: 150,
      onEnd: function() {
        var ids = [];
        $('#cms-blocks-list .cms-block-item').each(function(){ ids.push($(this).data('block-id')); });
        $.post('index.php?route=cms/page/reorderBlocks&user_token=' + userToken, { page_id: pageId, block_ids: ids });
      }
    });
  }
})();
</script>
{{ footer }}
