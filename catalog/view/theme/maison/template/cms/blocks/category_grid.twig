<section class="py-24 px-6 lg:px-12 max-w-7xl mx-auto bg-background-dark">
  <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
    <div>
      {% if title %}<h2 class="font-serif text-3xl md:text-4xl text-luxury-charcoal mb-4">{{ title }}</h2>{% endif %}
      {% if subtitle %}<p class="text-base text-luxury-charcoal/60 max-w-lg">{{ subtitle }}</p>{% endif %}
    </div>
    {% if link_text and link_href and link_href != '#' %}
    <a class="hidden md:inline-flex items-center text-luxury-charcoal text-xs font-bold uppercase tracking-widest border-b border-luxury-charcoal pb-1 hover:text-luxury-charcoal/70 transition-colors" href="{{ link_href }}">{{ link_text }}</a>
    {% endif %}
  </div>
  {% if tiles %}
  <div class="grid grid-cols-1 md:grid-cols-12 gap-6 h-auto md:h-[600px]">
    {% for tile in tiles %}
    <a class="group relative block overflow-hidden rounded bg-background-section h-64 md:h-full {% if tile.layout == 'large' %}md:col-span-8 md:row-span-2{% else %}md:col-span-4 md:row-span-1{% endif %}" href="{{ tile.href }}">
      {% if tile.image %}<img alt="{{ tile.name }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="{{ tile.image }}" />{% endif %}
      <div class="absolute inset-0 bg-gradient-to-t from-luxury-charcoal/60 via-transparent to-transparent"></div>
      <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full flex justify-between items-end">
        <h3 class="font-serif {% if tile.layout == 'large' %}text-2xl md:text-3xl{% else %}text-lg{% endif %} text-white m-0">{{ tile.name }}</h3>
        <span class="material-symbols-outlined text-white opacity-0 group-hover:opacity-100 transition-all duration-300">arrow_forward</span>
      </div>
    </a>
    {% endfor %}
  </div>
  {% endif %}
  {% if list %}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-0 mt-6 border-t border-luxury-silver/20">
    {% for item in list %}
    <a class="py-6 border-b md:border-b-0 md:border-r border-luxury-silver/20 flex justify-between items-center group px-4 hover:bg-white transition-colors last:border-r-0" href="{{ item.href }}">
      <span class="font-serif text-lg text-luxury-charcoal group-hover:text-badge-gold transition-colors">{{ item.name }}</span>
      <span class="material-symbols-outlined text-luxury-silver group-hover:text-badge-gold transition-colors">east</span>
    </a>
    {% endfor %}
  </div>
  {% endif %}
  {% if link_text and link_href and link_href != '#' %}
  <div class="mt-8 text-center md:hidden">
    <a class="inline-flex items-center text-luxury-charcoal text-xs font-bold uppercase tracking-widest border-b border-luxury-charcoal pb-1" href="{{ link_href }}">{{ link_text }}</a>
  </div>
  {% endif %}
</section>
